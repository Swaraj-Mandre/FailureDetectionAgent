%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Segoe UI", "fontSize": "16px", "lineColor": "#475569", "primaryTextColor": "#14213D", "edgeLabelBackground": "#FFFFFF"}}}%%
flowchart TD
    START(["START"])
    AGENT["<b>agent</b><br/>qwen2.5:3b + run_sql"]
    TOOLS[("<b>tools</b><br/>read-only SQL on shop.db")]
    ROUTE{"<b>route_after_tools</b><br/>did the tool fail?"}
    FAIL["<b>handle_failure</b><br/>sort the error, give a hint"]
    EXPLAIN["<b>agent explains</b><br/>tool locked, no retry"]
    DONE(["END"])

    START --> AGENT
    AGENT -->|tool call| TOOLS
    AGENT -->|final answer| DONE
    TOOLS --> ROUTE
    ROUTE -->|ok| AGENT
    ROUTE -->|Error| FAIL
    FAIL -->|"fixable: retry, 3 tries max"| AGENT
    FAIL -->|"unsafe or unreachable"| EXPLAIN
    EXPLAIN --> DONE

    classDef llm fill:#DBEAFE,stroke:#2563EB,stroke-width:2px,color:#14213D
    classDef check fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#14213D
    classDef fix fill:#D1FAE5,stroke:#059669,stroke-width:2px,color:#14213D
    classDef store fill:#F1F5F9,stroke:#64748B,stroke-width:1.5px,color:#14213D
    classDef term fill:#FFFFFF,stroke:#14213D,stroke-width:1.5px,color:#14213D
    classDef stop fill:#FFE4E6,stroke:#E11D48,stroke-width:2px,color:#14213D
    class AGENT llm
    class TOOLS store
    class ROUTE check
    class FAIL fix
    class EXPLAIN stop
    class START,DONE term
    linkStyle 5,6,7 stroke:#E11D48,stroke-width:2px
